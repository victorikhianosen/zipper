parameters:
    paths:
        - app
        - database/factories
        - database/seeders
        - routes
        - tests

    level: 8

    checkGenericClassInNonGenericObjectType: false

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            message: '#Access to an undefined property [a-zA-Z0-9\\_]+::\$#'
            path: app/Http/Resources/
    excludePaths:

includes:
    - vendor/nunomaduro/larastan/extension.neon
