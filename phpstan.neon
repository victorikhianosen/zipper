parameters:
    paths:
        - app
        - database/factories
        - database/seeders
        - routes
        - tests

    level: 8

    checkGenericClassInNonGenericObjectType: false

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
    excludePaths:

includes:
    - vendor/nunomaduro/larastan/extension.neon
